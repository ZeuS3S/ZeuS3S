DISCORD_TOKEN=ton_token_ici
# IDs Discord des owners du bot, séparés par des virgules (le propriétaire de l'application l'est déjà).
OWNER_IDS=
# Optionnel : serveur où enregistrer /owner (sinon /owner est global, visible des admins mais réservé aux owners).
OWNER_GUILD_ID=
# Optionnel : salon où le bot journalise les clés, essais et premiums (ID).
PREMIUM_LOG_CHANNEL_ID=
# Optionnel : lien de ton serveur support (bouton dans /help).
SUPPORT_URL=
# Optionnel : port de l'adresse de santé (http://ton-serveur:PORT/health) à surveiller avec UptimeRobot.
HEALTH_PORT=
