DISCORD_TOKEN=le_token_du_bot
TRAP_CHANNEL_ID=id_du_salon_piege
# Optionnel : salon où le bot poste un log à chaque ban
LOG_CHANNEL_ID=
# Optionnel : supprime les messages des dernières X secondes du banni (max 604800 = 7 jours)
DELETE_SECONDS=3600

# Rôle automatique selon le statut personnalisé (laisse vide pour désactiver)
# Texte à trouver dans le statut, par exemple discord.gg/movixfr
STATUS_KEYWORD=
# ID du rôle donné (et retiré si le texte disparaît)
STATUS_ROLE_ID=
